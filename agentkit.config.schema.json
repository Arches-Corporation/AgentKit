{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentKit configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stateDir": {
      "type": "string",
      "description": "Runtime state dir (markers, logs) relative to repo root",
      "default": ".agentkit/state"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
      "description": "Project pack name (src/projects/<name>/ in AgentKit)"
    },
    "localGuardrailsDir": {
      "type": "string",
      "description": "Repo-local guardrails dir (prototyping tier)",
      "default": ".agentkit/guardrails"
    },
    "skills": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Managed-asset distribution settings (agentkit sync); vars is the single template-variable pool for all asset kinds",
          "properties": {
            "vars": {
              "type": "object",
              "description": "Template variables rendered into managed skills",
              "additionalProperties": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "description": "Kit skill names this repo opts out of",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "boolean",
          "const": false,
          "description": "false disables all managed skills (guardrails-only style install)"
        }
      ]
    },
    "guardrails": {
      "type": "object",
      "description": "Per-guardrail settings, keyed by guardrail name",
      "properties": {
        "hard-stop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvalMarker": {
              "type": "string"
            }
          }
        },
        "spec-first": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "approvalMarker": {
              "type": "string"
            },
            "ticketPattern": {
              "type": "string",
              "description": "Regex matched against the branch name"
            },
            "codePathPatterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "specDirTemplate": {
              "type": "string",
              "description": "{ticket} is replaced with the uppercased ticket id"
            },
            "requireSpecDir": {
              "type": "boolean"
            },
            "hintText": {
              "type": "string"
            }
          }
        },
        "privacy-block": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sensitive": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "safe": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "secret-output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraPatterns": {
              "$ref": "#/definitions/patternList"
            }
          }
        },
        "scout-block": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ignoreFile": {
              "type": "string"
            },
            "fallbackDirs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "force-push-guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowForceWithLease": {
              "type": "boolean"
            },
            "approvalMarker": {
              "type": "string"
            }
          }
        },
        "db-guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraPatterns": {
              "$ref": "#/definitions/patternList"
            },
            "approvalMarker": {
              "type": "string"
            }
          }
        },
        "rules-reminder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "text": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "oncePerSession": {
              "type": "boolean"
            }
          }
        },
        "tamper-guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Note: tamper-guard is always-on at runtime; this flag only affects wiring checks."
            },
            "protect": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Extra repo-relative paths (dirs end with /) the guard protects beyond the built-in enforcement-layer set."
            }
          }
        },
        "usage-telemetry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sinkMode": {
              "type": "string",
              "enum": ["none", "file", "endpoint", "otel"],
              "description": "Where usage is exported: none (local only), file (write JSON into sinkPath), endpoint (POST rollup JSON to sinkUrl), otel (drain per-event OTLP/HTTP logs to otelEndpoint)."
            },
            "sinkPath": {
              "type": "string",
              "description": "Directory for file-mode exports (absolute allowed — e.g. a Drive-synced folder)."
            },
            "sinkUrl": {
              "type": "string",
              "description": "URL for endpoint-mode exports (POST, JSON body)."
            },
            "sinkAuthTokenEnv": {
              "type": "string",
              "description": "Name of an env var holding a bearer token for endpoint mode — never the token itself."
            },
            "otelEndpoint": {
              "type": "string",
              "description": "OTLP/HTTP logs URL for otel-mode exports (e.g. https://collector.example.com/v1/logs). Per-event LogRecords carry tool_use_id for correlation with Claude Code's native tool_decision events."
            },
            "otelHeaders": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Extra HTTP headers for otel mode as \"Key: Value\" strings (e.g. collector auth). https required if an Authorization header is present. Prefer otelAuthTokenEnv for the credential — keep secrets out of config."
            },
            "otelAuthTokenEnv": {
              "type": "string",
              "description": "Name of an env var holding the full Authorization header value for otel mode (e.g. \"Basic <base64>\" or \"Bearer <token>\") — never the credential itself. Injected at export time; overrides any Authorization in otelHeaders. https required."
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "description": "Pack or repo-local guardrail settings — keys validated by `agentkit doctor` against the guardrail's declared defaults",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "commands": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Managed command distribution settings (agentkit sync)",
          "properties": {
            "exclude": {
              "type": "array",
              "description": "Kit command names this repo opts out of",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "boolean",
          "const": false,
          "description": "false disables all managed commands (guardrails-only style install)"
        }
      ]
    },
    "agents": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Managed agent distribution settings (agentkit sync)",
          "properties": {
            "exclude": {
              "type": "array",
              "description": "Kit agent names this repo opts out of",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "boolean",
          "const": false,
          "description": "false disables all managed agents (guardrails-only style install)"
        }
      ]
    },
    "rulebooks": {
      "description": "Rulebook files to auto-inject the managed agentkit block into (default: CLAUDE.md/AGENTS.md/GEMINI.md/.cursor/rules/agentkit.md that exist; seeds CLAUDE.md if none). false = opt out.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    }
  },
  "definitions": {
    "patternList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "pattern": {
            "type": "string"
          },
          "flags": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
